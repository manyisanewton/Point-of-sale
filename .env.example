# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
# Use Neon, Supabase, or other PostgreSQL provider
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# ============================================
# ADMIN CREDENTIALS (for initial setup)
# ============================================
# These are used to create the first admin user during database seeding
# After seeding, only password_hash is stored in the database
ADMIN_EMAIL="admin@opendoorslaundromat.co.ke"
ADMIN_PASSWORD="your-strong-admin-password-here"
# Optional PIN for revealing financial totals; if omitted, the admin password is used.
REPORT_AMOUNT_PIN=""

# WhatsApp Business Platform Cloud API (needed for one-action campaigns)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v24.0"
# Approved WhatsApp marketing template with one body text placeholder for the campaign message
WHATSAPP_BROADCAST_TEMPLATE=""
WHATSAPP_BROADCAST_LANGUAGE="en"

# ============================================
# SESSION SECURITY
# ============================================
# Generate a strong random secret (32+ bytes)
# Use: openssl rand -base64 32
SESSION_SECRET="your-32-byte-or-longer-random-secret-here"

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV="development"

# ============================================
# SERVER
# ============================================
# Port for the Express server (default: 3001)
PORT=3001

# ============================================
# VERCEL
# ============================================
# Vercel will automatically set these in production
# DO NOT set DATABASE_URL in Vercel's frontend environment variables
# Only set it in the backend/server environment
